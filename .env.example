# ---------- Providers ----------
# Pluggable, but DATABASE_URL is mandatory (Postgres + pgvector is the only
# datastore since R5) and the pgvector chunk table is vector(1536), so the
# embedding provider must be 1536-dim:
# openai (default: text-embedding-3-small, 1536-dim, needs OPENAI_API_KEY)
#   | local-bge-small (384-dim; offline/eval tooling only — rejected against
#     the app datastore by the dimension assert; needs the `local-embeddings`
#     extra) | echo (test-only, 1536-dim)
EMBEDDING_PROVIDER=openai
# Echo providers + a non-empty corpus refuse to boot unless this is 1 (tests/CI only).
REGWATCH_ALLOW_TEST_PROVIDERS=0
LLM_PROVIDER=openai            # openai | anthropic | echo (test-only)
# OpenAI call surface: responses (default, GPT-5.x native) | chat (legacy Chat Completions)
OPENAI_API_MODE=responses
# Role-specific models (each falls back to LLM_MODEL if unset).
# Router/classifier: cheapest reasoning model. Synthesis + BE extraction: more capable.
ROUTER_MODEL=gpt-5-nano
SYNTHESIZER_MODEL=gpt-5.4-nano
EXTRACTOR_MODEL=gpt-5.4-nano
LLM_MODEL=gpt-5.4-nano         # legacy single-model fallback (opaque to business logic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- openFDA ----------
# Optional. Without it, openFDA still works but with stricter rate limits.
OPENFDA_API_KEY=

# ---------- Company / watchlist ----------
COMPANY_NAME=Amneal
# Comma-separated applicant aliases used in Drugs@FDA sponsor matching.
COMPANY_APPLICANT_ALIASES=AMNEAL PHARMS,AMNEAL PHARMACEUTICALS,AMNEAL PHARMS LLC

# ---------- Retrieval / refusal ----------
# Two-stage retrieval per the spec:
#   stage 1: vector top-K (wide)   stage 2: rerank top-K (narrow)
# Reranker is off by default (RERANKER_ENABLED=false); when off, stage 2
# is just `passages[:rerank_top_k]`.
VECTOR_TOP_K=50
RERANK_TOP_K=8
# Cosine similarity threshold below which the system MUST refuse.
REFUSAL_SCORE_THRESHOLD=0.30
RERANKER_ENABLED=false
# TTL (seconds) for the in-process distinct-metadata cache (the resolver's
# "which drugs exist" set). Bounds how long the long-lived API process serves a
# stale set after a SEPARATE ingest adds a drug. 0 disables the TTL.
METADATA_CACHE_TTL_S=60
# Override the refusal message shown when the corpus has no grounded answer.
REFUSAL_TEXT=I can't find this in the current FDA guidance corpus. I won't guess on a regulatory question.

# ---------- Storage paths ----------
# Raw/processed PDFs only — the structured store and vectors both live in
# Postgres (DATABASE_URL below), not under ./data (SQLite/Chroma were
# removed in R5).
DATA_DIR=./data
RAW_PDF_DIR=./data/raw
PROCESSED_DIR=./data/processed

# ---------- Postgres / Supabase (mandatory) ----------
# Postgres + pgvector is the only datastore (R5 deleted the SQLite/Chroma
# dual-mode): the app REFUSES to boot with this empty, no flag needed. The
# structured store AND the vectors (pgvector) live in this ONE database.
# Use the Supabase SESSION pooler URI (port 5432, not the transaction pooler
# on 6543) in production; a bare postgresql:// is normalized to
# postgresql+psycopg:// automatically. For local dev, point this at a local
# Postgres with the pgvector extension (Compose's `db` service does this).
# Production pairing: DATABASE_URL + EMBEDDING_PROVIDER=openai + OPENAI_API_KEY
# (the chunk table is vector(1536) = text-embedding-3-small; startup fails fast
# on a provider/table dimension mismatch). Runbook: docs/DEPLOY.md.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Per-connection Postgres timeouts (applied via libpq `options` in store/db.py).
# The `postgres` role ships with NO server-side timeouts, so a connection that
# stalls mid-transaction holds its locks forever — this is the Jun-18 incident
# fix. GUC duration strings ('30s','500ms'); set to '0' or '' to disable one.
# idle-in-tx + lock timeouts are the load-bearing pair (safe for bulk work).
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_TIMEOUT=60s
DB_LOCK_TIMEOUT=10s
# Bound the TCP/TLS connection handshake to the Supabase pooler (libpq
# connect_timeout, integer SECONDS). The GUC timeouts above only bound a query
# after the session exists; without this a stalled handshake hangs a request
# thread forever. '0' or '' disables the bound (handshake unbounded).
DB_CONNECT_TIMEOUT=10
# Recycle pooled connections (seconds) before Supavisor's idle cutoff so a stale
# server-side socket is never handed to a request. Pairs with pool_pre_ping.
DB_POOL_RECYCLE_S=1800

# ---------- LLM client transport (B3) ----------
# Bound the OpenAI/Anthropic SDK timeout + retries. The SDK default (600s read,
# 2 retries) can pin a request worker for ~10-20 min during a provider stall.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# USD-per-1M-token price table as JSON, keyed by model name. Used only for the
# query_log cost column; an unknown model logs cost NULL, never a guessed price.
# LLM_MODEL_PRICES={"gpt-5.4-nano": {"input": 0.05, "output": 0.40}}

# ---------- Observability (Sentry) ----------
# Error tracking. OFF unless set. In production (SENTRY_ENVIRONMENT=production)
# a missing DSN logs a loud boot warning. Set as a secret on the platform.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# ---------- Crawler ----------
USER_AGENT=RegWatch/0.1 (clinical-regulatory-affairs; +https://example.invalid/contact)
HTTP_TIMEOUT_S=30
CRAWL_CONCURRENCY=4
CRAWL_MIN_INTERVAL_MS=250
# In-process cache TTL (seconds) for the ~50k-row Orange Book products ZIP,
# which changes at most monthly. 0 disables caching.
ORANGE_BOOK_CACHE_TTL_S=86400

# ---------- PDF ingest safety (cron/ingest worker only) ----------
# Bound a malformed/oversized PDF from hanging or OOM-ing the daily `watch` run
# (the SOLE driver of FDA alerts). Not reachable from the API. 0 disables a guard.
# Cap the downloaded PDF before it is buffered/parsed (real PSG PDFs are <2 MiB).
PDF_MAX_BYTES=52428800
# Hard wall-clock cap (seconds) on text extraction, run in a killable child proc.
PDF_PARSE_TIMEOUT_S=60
# Max page count, checked in the parse child before any per-page text extraction
# (real PSGs run under ~20 pages; a page-flood fits under the byte cap).
PDF_MAX_PAGES=500

# ---------- White Paper populator ----------
# The Word template the CRA White Paper populator fills. Gitignored (internal
# artifact), so it is NOT in the repo or the image. When absent (CI, or a fresh
# deploy) the docx writer builds a structurally-equivalent document from scratch,
# stamped "(generated without the official CRA template file)". In containers the
# default is /app/data/templates/cra_white_paper_template.docx (under the mounted
# data volume) — see docs/DEPLOY.md. Locally, point this at your copy:
WHITEPAPER_TEMPLATE_PATH=./CRA White Paper Template May 2026 - Raja.docx
# Prod has no persistent volume, so WHITEPAPER_TEMPLATE_PATH never survives a
# deploy there. Set this to a long-lived signed URL to the private Supabase
# Storage object (Fly secret) and the render path lazily fetches + caches it
# at WHITEPAPER_TEMPLATE_PATH on first use. Leave unset for local dev.
# WHITEPAPER_TEMPLATE_URL=
# Overall deadline (seconds) for the populate's live FDA fetches. A fetch-phase
# breach fails the build with an audited status="error" row and the API returns
# 504; during cell build the lazy REMS fetch / nested PSG ask are gated on the
# remaining time and degrade their cells instead. Keep it safely under the UI's
# 120s POST /whitepaper bound; 0 disables it (CLI/batch use -- per-call HTTP
# timeouts still apply).
WHITEPAPER_BUILD_TIMEOUT_S=90

# ---------- Auth ----------
# Cookie-session auth: POST /auth/login sets an HttpOnly `regwatch_session`
# cookie; the DB stores only the sha256 of the opaque token. Users are
# provisioned with `uv run regwatch create-user` (no self-signup).
# Secure cookie flag — keep false for the http://localhost pilot; set true
# the moment the API is served over TLS.
AUTH_COOKIE_SECURE=false
# Server-side session lifetime; the cookie Max-Age matches.
AUTH_SESSION_TTL_HOURS=72
# Per-user requests/minute on POST /query and POST /assemble (LLM cost +
# abuse surface). 0 disables. Login attempts are separately capped at
# 10/email/minute AND 30/IP/minute (fixed).
RATE_LIMIT_PER_MINUTE=30
# Trust platform forwarding headers for the per-IP login limiter key. Keep false
# when the API is reached directly (X-Forwarded-For is client-controlled and its
# leftmost hop is spoofable). Set true ONLY behind a proxy/LB whose edge attests
# the real client. On Fly the attested client is in Fly-Client-IP (preferred);
# Fly APPENDS to X-Forwarded-For rather than overwriting it, so the limiter uses
# the rightmost XFF hop, never the spoofable leftmost.
TRUST_PROXY_HEADERS=false
# Opt-in bearer gate for GET /metrics (aggregate query counts). Leave UNSET to
# keep /metrics OPEN exactly as today (an existing Prometheus scrape keeps
# working with no change). Set it to require `Authorization: Bearer <token>` on
# /metrics; the scraper config then sends that header. Never gates /health or
# /ready. Empty value = unset = open.
# METRICS_TOKEN=
# Shared secret gating the internal RAG compute endpoint (POST
# /internal/query/compute) the Go control plane calls for the step-5
# CompleteQuery cutover. FAIL-CLOSED: unset ("") makes the endpoint 404 and the
# native /query synthesizes an upstream_error, so set the SAME value on both the
# Python app and the Go proxy (a Fly app-wide secret) before enabling the Go
# native query flag. Never exposed at the public edge (the proxy 404s the
# /internal/ subtree). Empty value = unset = endpoint disabled.
# INTERNAL_RAG_TOKEN=
# Comma-separated CORS allowlist for the Next.js UI. With allow_credentials=True
# on the API, this is what stops other origins from riding the session cookie —
# keep it tight. Set to your deployed frontend origin(s) in production.
CORS_ALLOW_ORIGINS_CSV=http://localhost:3000,http://127.0.0.1:3000
