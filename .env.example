# ---------- Providers ----------
# Last updated: 2026-08-11
# Pluggable, but DATABASE_URL is mandatory: Postgres + pgvector is the only
# datastore since R5.
#
# ACTIVE_EMBEDDING_PROFILE (below) decides which embedder retrieval uses.
# EMBEDDING_PROVIDER is read ONLY by the "legacy" arm, which serves the
# chunk.embedding column, and that column is vector(1536). A named profile
# stores its vectors in chunk_embedding and brings its own embedder, so on a
# profile-backed deployment this key does nothing on the query path.
# PRODUCTION runs a named Databricks Qwen3 profile at 1024 dimensions, so the
# value below is a local-dev default, not what prod serves.
#
# Legacy-arm choices:
#   openai (default: text-embedding-3-small, 1536-dim, needs OPENAI_API_KEY)
#   qwen3 (private Qwen3 OpenAI-compatible endpoint; the defaults below ask it
#     for a 1536-dim Matryoshka output)
#   local-bge-small (384-dim; offline/eval tooling only, rejected against the
#     app datastore by the dimension assert; needs the `local-embeddings` extra)
#   echo (test-only, 1536-dim)
EMBEDDING_PROVIDER=openai
# During a shadow or promotion window, leave this on the OLD provider so an
# immediate rollback still has vectors to fall back to. Once a profile is
# promoted, qwen3 writes named profiles and leaves the legacy vector NULL.
# Prod finished that cutover on 2026-07-30.
# Private Qwen3 endpoint. For Databricks, use the OpenAI-compatible serving base
# URL and a service-principal token; never use a personal access token in prod.
# QWEN_EMBEDDING_BASE_URL=https://<workspace>/serving-endpoints
QWEN_EMBEDDING_TOKEN=
# OpenAI-compatible `model` field. Databricks normally expects the deployed
# endpoint name; vLLM may expose the served repository/model name.
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# Qwen3-Embedding-4B is natively 2560-dim. The 1536 below is a Matryoshka
# profile kept so local dev matches the legacy pgvector shape. Prod does NOT
# use it: the live prod profile is 1024-dim on the Databricks Qwen3 endpoint.
QWEN_EMBEDDING_DIMENSION=1536
QWEN_EMBEDDING_BATCH_SIZE=128
QWEN_EMBEDDING_QUERY_INSTRUCTION=Given a pharmaceutical regulatory question, retrieve FDA product-specific guidance passages containing the evidence needed to answer it.
QWEN_EMBEDDING_QUERY_INSTRUCTION_VERSION=regwatch-regulatory-retrieval-v1
QWEN_EMBEDDING_REVISION=5cf2132abc99cad020ac570b19d031efec650f2b
# Which embedding arm retrieval uses. "legacy" serves the chunk.embedding
# column. A named profile serves chunk_embedding, and it is populated and
# evaluated in shadow before it is promoted. Prod runs the promoted Qwen3
# profile ep_2e7368b354d911ea3a013c3125e276c2 (1024-dim, full coverage);
# "legacy" below is the local-dev default.
ACTIVE_EMBEDDING_PROFILE=legacy
# Reversible corpus cutover. Keep legacy until `regwatch
# authoritative-corpus-status` reports activation_ready=true.
REGWATCH_RETRIEVAL_CORPUS=legacy
# EMBEDDING_SHADOW_PROFILE=
# Echo providers + a non-empty corpus refuse to boot unless this is 1 (tests/CI only).
REGWATCH_ALLOW_TEST_PROVIDERS=0
LLM_PROVIDER=openai            # openai | databricks | anthropic | echo (test-only)
# Private Databricks OpenAI-compatible endpoint. Prod serves gpt-oss-120b
# (served id gpt-oss-120b-080525) through the Unity Catalog alias
# workspace.default.regwatch, one model for every role: router, synthesizer and
# extractor. The provider also supports Gemma-family endpoints
# (GEMMA_THINKING_ENABLED).
# DATABRICKS_LLM_BASE_URL=https://<workspace>/serving-endpoints
DATABRICKS_LLM_TOKEN=
# The Databricks SERVING ENDPOINT NAME sent as the OpenAI-compatible `model`
# field. No default: a placeholder here would 404 every synthesis, and the
# provider-error boundary would turn each 404 into an audited refusal -- the
# app looks alive while refusing every question.
DATABRICKS_LLM_MODEL=
# Eligible only for synthesizer calls; router/extractor always force thinking off.
GEMMA_THINKING_ENABLED=false
# v6 prose synthesis (slm-layer Phase A): true switches the synthesizer from
# the v5 claims-JSON contract to natural prose with [n] markers, parsed
# server-side and admitted by the same gate. v5 and v6 share the same
# cite-or-refuse policy; only the FORMAT differs. The policy change lives in
# REGWATCH_SELECTIVE_CITATION below. Empty or unset means OFF. Prod has this
# ON. Keep GEMMA_THINKING_ENABLED unset/false through the prose rollout (prose
# makes thinking reachable for the synthesizer for the first time).
REGWATCH_PROSE_SYNTHESIS=false
# Live provisional draft streaming over SSE (owner-amended INV-1, 2026-08-10).
# Effective only when REGWATCH_PROSE_SYNTHESIS is also true AND the request
# opts in (QueryRequest.live_draft); empty or unset means OFF. Prod has this ON.
REGWATCH_LIVE_DRAFT=false
# PR11b conversational route/scope observation. `off` makes no extra call;
# `shadow` makes one bounded router call and records its advisory decision plus
# the application-compiled scope under query_log.route_json.route_call. Neither
# retrieval nor response behavior reads it. `live` is reserved but deliberately
# remains shadow-equivalent until PR12. Probe the served endpoint's reasoning
# floor before enabling and size this cap above that floor plus the JSON body.
REGWATCH_ROUTE_CALL=off
REGWATCH_ROUTE_MAX_TOKENS=1200
# v7 selective citation (slm-layer Phase B): true switches the POLICY on top of
# v6's prose format. Every sentence is one of three kinds. A SOURCE FACT must
# end with its passage number(s). REASONING and CONVERSATION carry no numbers.
# "I found nothing" is written as plain conversation, so there is no
# NO_EVIDENCE code word in v7. INV-1 is unchanged and still enforced in code:
# an uncited source fact is still dropped by the gate. Only honored when
# REGWATCH_PROSE_SYNTHESIS is also true. Empty or unset means OFF. Prod has
# this ON.
REGWATCH_SELECTIVE_CITATION=false
# How much a REASONING model may spend thinking before it answers: low | medium
# | high, or empty to send no parameter at all (for endpoints that reject it).
# Thought and answer share one SYNTHESIZER_MAX_TOKENS budget, so an unbounded
# effort burns the budget on reasoning, returns finish_reason=length, and the
# provider raises -- which the app degrades into an audited refusal. Measured
# on the gpt-oss-20b endpoint at a 900-token cap: low finished; default, medium
# and high all hit the cap. That measurement is HISTORICAL: the alias was
# repointed to gpt-oss-120b on 2026-08-05 and has not been re-measured. Sent
# for every role, including JSON mode. Ignored by non-reasoning models.
DATABRICKS_REASONING_EFFORT=low
# ---- D1 residency tripwires (docs/DATABRICKS_ADOPTION_2026-07-28.md) --------
# D1 itself is CLOSED: generation, query embedding and the database all sit
# inside the company's own Databricks tenant. These knobs are the guardrail
# that keeps it closed, and they stay inert until armed. When true, this
# refuses to boot if generation and query embedding are only half-migrated
# (either half alone still sends the analyst question to OpenAI), or if
# DATABRICKS_LLM_MODEL is outside the declared allowlist / names a
# partner-hosted family carrying its own retention terms.
# Armed, it ALSO checks every response against the allowlist and refuses the
# answer when the model that actually served it is off-perimeter.
D1_ENFORCED=false
# JSON list of models verified as open-weight and in-perimeter.
# Required when D1_ENFORCED=true -- empty means refuse, never "trust it".
# List BOTH names when DATABRICKS_LLM_MODEL is a Unity Catalog alias: the alias
# itself (checked at boot) AND the model id the endpoint reports in its
# responses (checked per response), e.g.
# D1_ALLOWED_LLM_MODELS=["workspace.default.regwatch","gpt-oss-120b-080525"].
# With only the alias listed, the first armed boot refuses every turn.
D1_ALLOWED_LLM_MODELS=[]
# OpenAI call surface: responses (default, GPT-5.x native) | chat (legacy Chat Completions)
OPENAI_API_MODE=responses
# Role-specific models (each falls back to LLM_MODEL if unset).
# Router/classifier: cheapest reasoning model. Synthesis + BE extraction: more capable.
ROUTER_MODEL=gpt-5-nano
SYNTHESIZER_MODEL=gpt-5.4-nano
EXTRACTOR_MODEL=gpt-5.4-nano
# Output cap for synthesis only. Sized off the SCHEMA ceiling, not observed
# usage: a truncated JSON turn is unparseable, so undershooting costs the WHOLE
# answer (an audited malformed_structure refusal), not a sentence. 20 claims x
# 250 chars x 2 cites = 2,317 tokens + ~500 for reasoning -> 3000.
# A reasoning model spends part of this budget thinking (see
# DATABRICKS_REASONING_EFFORT).
# Must stay strictly BELOW SYNTH_MAX_TOKENS_CEILING (6000, config/settings.py):
# at or above it the first call is silently clamped AND the truncation retry
# silently stops working, so the app refuses to boot instead.
SYNTHESIZER_MAX_TOKENS=3000
LLM_MODEL=gpt-5.4-nano         # legacy single-model fallback (opaque to business logic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Company / watchlist ----------
COMPANY_NAME=Amneal
# Comma-separated applicant aliases used in Drugs@FDA sponsor matching.
COMPANY_APPLICANT_ALIASES=AMNEAL PHARMS,AMNEAL PHARMACEUTICALS,AMNEAL PHARMS LLC

# ---------- Retrieval / refusal ----------
# Two-stage retrieval per the spec:
#   stage 1: vector top-K (wide)   stage 2: rerank top-K (narrow)
# Reranker is off by default (RERANKER_ENABLED=false); when off, stage 2
# is just `passages[:rerank_top_k]`.
VECTOR_TOP_K=50
RERANK_TOP_K=8
# Cosine similarity threshold below which the system MUST refuse.
# 0.30 was validated against the OLD OpenAI vector space. The live space is now
# Qwen3 1024-dim, so that validation does not carry over. Treat 0.30 as
# unvalidated in production.
REFUSAL_SCORE_THRESHOLD=0.30
RERANKER_ENABLED=false
# MMR diversity in stage 2 (docs/DSA.md section 33). Off = the plain
# `passages[:RERANK_TOP_K]` slice. On = the same COUNT of passages, but a
# near-duplicate of one already selected loses its slot to a distinct passage.
# Text-based similarity only: no extra embedding call, no extra query.
REGWATCH_MMR_DIVERSITY=false
# TTL (seconds) for the in-process distinct-metadata cache (the resolver's
# "which drugs exist" set). Bounds how long the long-lived API process serves a
# stale set after a SEPARATE ingest adds a drug. 0 disables the TTL.
METADATA_CACHE_TTL_S=60
# The app's own decline copy. Under v7 the model usually writes its own "I
# don't have that" reply in plain words; this text is served instead when a
# gate guard blocks the model's wording, or when the turn declines before any
# model text exists (no product, weak retrieval, provider error).
REFUSAL_TEXT=I can't find this in the current FDA guidance corpus. I won't guess on a regulatory question.

# ---------- Storage paths ----------
# Raw/processed PDFs only. The structured store and vectors both live in
# Postgres (DATABASE_URL below), not under ./data (SQLite/Chroma were
# removed in R5).
DATA_DIR=./data
RAW_PDF_DIR=./data/raw
PROCESSED_DIR=./data/processed

# ---------- Postgres / Databricks Lakebase (mandatory) ----------
# Postgres + pgvector is the only datastore (R5 deleted the SQLite/Chroma
# dual-mode): the app REFUSES to boot with this empty, no flag needed. The
# structured store AND the vectors (pgvector) live in this ONE database.
# A bare postgresql:// is normalized to postgresql+psycopg:// automatically.
# For local dev, point this at a local Postgres with the pgvector extension
# (Compose's `db` service does this). Runbook: docs/DEPLOY.md.
#
# PRODUCTION is Databricks Lakebase (Autoscaling, PG 17). Use the DIRECT
# endpoint -- a host containing "-pooler" is PgBouncer transaction mode, which
# breaks pgx's default QueryExecModeCacheStatement in go/internal/store/pool.go
# and would take out the Go proxy holding the public edge. sslmode=require is
# added automatically for any non-local host (store/db.py:_enforce_sslmode).
# DATABASE_URL=postgresql://<role>:<password>@ep-<id>.database.<region>.cloud.databricks.com:5432/databricks_postgres
# Two Lakebase prerequisites that CANNOT be expressed in this URL:
#  1. search_path. pgvector lives in the `extensions` schema while Lakebase
#     defaults to `"$user", public`, so the bare `vector` type and the `<=>`
#     operator do not resolve. `?options=-csearch_path=...` does NOT survive:
#     _pg_connect_args passes its own libpq `options`, and connect_args
#     overwrite the URL query. Set it on the role instead:
#       ALTER ROLE <role> SET search_path TO public, extensions;
#  2. RLS is deny-all (enabled, no policies). A grant-only role connects fine
#     and reads zero rows, so the app boots healthy and refuses every question.
#     The role needs BYPASSRLS or table ownership. Migrations additionally need
#     ownership; run them as a service principal, not a personal identity.
#     Use native password auth: Databricks OAuth tokens expire after 1 hour.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Per-connection Postgres timeouts (applied via libpq `options` in store/db.py).
# The `postgres` role ships with NO server-side timeouts, so a connection that
# stalls mid-transaction holds its locks forever. This is the Jun-18 incident
# fix. GUC duration strings ('30s','500ms'); set to '0' or '' to disable one.
# idle-in-tx + lock timeouts are the load-bearing pair (safe for bulk work).
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_TIMEOUT=60s
DB_LOCK_TIMEOUT=10s
# Bound the TCP/TLS connection handshake itself (libpq connect_timeout, integer
# SECONDS). The GUC timeouts above only bound a query after the session exists;
# without this a stalled handshake hangs a request thread forever. '0' or ''
# disables the bound (handshake unbounded).
DB_CONNECT_TIMEOUT=10
# Recycle pooled connections (seconds) before the server's own idle cutoff, so a
# stale server-side socket is never handed to a request. Pairs with
# pool_pre_ping.
DB_POOL_RECYCLE_S=1800

# ---------- LLM client transport (B3) ----------
# Bound the OpenAI/Anthropic SDK timeout + retries. The SDK default (600s read,
# 2 retries) can pin a request worker for ~10-20 min during a provider stall.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# USD-per-1M-token price table as JSON, keyed by model name. Used only for the
# query_log cost column; an unknown model logs cost NULL, never a guessed price.
# LLM_MODEL_PRICES={"gpt-5.4-nano": {"input": 0.05, "output": 0.40}}

# ---------- Observability (Sentry) ----------
# Error tracking. OFF unless set. In production (SENTRY_ENVIRONMENT=production)
# a missing DSN logs a loud boot warning. Set as a secret on the platform.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# ---------- Crawler ----------
USER_AGENT=RegWatch/0.1 (clinical-regulatory-affairs; +https://example.invalid/contact)
HTTP_TIMEOUT_S=30
CRAWL_CONCURRENCY=4
CRAWL_MIN_INTERVAL_MS=250
# In-process cache TTL (seconds) for the ~50k-row Orange Book products ZIP,
# which changes at most monthly. 0 disables caching.
ORANGE_BOOK_CACHE_TTL_S=86400
DRUGSFDA_CACHE_TTL_S=86400
DRUGSFDA_ZIP_MAX_BYTES=134217728
ORANGE_BOOK_ZIP_MAX_BYTES=33554432
FDA_CORPUS_PDF_MAX_BYTES=209715200
FDA_CORPUS_PDF_MAX_PAGES=3000
FDA_CORPUS_PDF_PARSE_TIMEOUT_S=180

# ---------- PDF ingest safety (cron/ingest worker only) ----------
# Bound a malformed/oversized PDF from hanging or OOM-ing the daily `watch` run
# (the SOLE driver of FDA alerts). Not reachable from the API. 0 disables a guard.
# Cap the downloaded PDF before it is buffered/parsed (real PSG PDFs are <2 MiB).
PDF_MAX_BYTES=52428800
# Hard wall-clock cap (seconds) on text extraction, run in a killable child proc.
PDF_PARSE_TIMEOUT_S=60
# Max page count, checked in the parse child before any per-page text extraction
# (real PSGs run under ~20 pages; a page-flood fits under the byte cap).
PDF_MAX_PAGES=500

# ---------- White Paper populator ----------
# The Word template the CRA White Paper populator fills. Gitignored (internal
# artifact), so it is NOT in the repo or the image. When absent (CI, or a fresh
# deploy) the docx writer builds a structurally-equivalent document from scratch,
# stamped "(generated without the official CRA template file)". In containers the
# default is /app/data/templates/cra_white_paper_template.docx (under the mounted
# data volume). See docs/DEPLOY.md. Locally, point this at your copy:
WHITEPAPER_TEMPLATE_PATH=./CRA White Paper Template May 2026 - Raja.docx
# Prod has no persistent volume, so WHITEPAPER_TEMPLATE_PATH never survives a
# deploy there. Set this to a long-lived signed URL to the private object-store
# copy of the template (Fly secret) and the render path lazily fetches + caches it
# at WHITEPAPER_TEMPLATE_PATH on first use. Leave unset for local dev.
# WHITEPAPER_TEMPLATE_URL=
# Overall deadline (seconds) for the populate's live FDA fetches. A fetch-phase
# breach fails the build with an audited status="error" row and the API returns
# 504; during cell build the lazy REMS fetch / nested PSG ask are gated on the
# remaining time and degrade their cells instead. Keep it safely under the UI's
# 120s POST /whitepaper bound; 0 disables it (CLI/batch use -- per-call HTTP
# timeouts still apply).
WHITEPAPER_BUILD_TIMEOUT_S=90

# ---------- Auth ----------
# Cookie-session auth: POST /auth/login sets an HttpOnly `regwatch_session`
# cookie; the DB stores only the sha256 of the opaque token. Users are
# provisioned with `uv run regwatch create-user` (no self-signup).
# Secure cookie flag. Keep false for the http://localhost pilot; set true
# the moment the API is served over TLS.
AUTH_COOKIE_SECURE=false
# Server-side session lifetime; the cookie Max-Age matches.
AUTH_SESSION_TTL_HOURS=72
# Per-user requests/minute on POST /query and POST /assemble (LLM cost +
# abuse surface). 0 disables. Login attempts are separately capped at
# 10/email/minute AND 30/IP/minute (fixed).
RATE_LIMIT_PER_MINUTE=30
# Trust platform forwarding headers for the per-IP login limiter key. Keep false
# when the API is reached directly (X-Forwarded-For is client-controlled and its
# leftmost hop is spoofable). Set true ONLY behind a proxy/LB whose edge attests
# the real client. On Fly the attested client is in Fly-Client-IP (preferred);
# Fly APPENDS to X-Forwarded-For rather than overwriting it, so the limiter uses
# the rightmost XFF hop, never the spoofable leftmost.
TRUST_PROXY_HEADERS=false
# Opt-in bearer gate for GET /metrics (aggregate query counts). Leave UNSET to
# keep /metrics OPEN exactly as today (an existing Prometheus scrape keeps
# working with no change). Set it to require `Authorization: Bearer <token>` on
# /metrics; the scraper config then sends that header. Never gates /health or
# /ready. Empty value = unset = open.
# METRICS_TOKEN=
# Shared secret gating the internal RAG compute endpoint (POST
# /internal/query/compute) the Go control plane calls for the step-5
# CompleteQuery cutover. FAIL-CLOSED: unset ("") makes the endpoint 404 and the
# native /query synthesizes an upstream_error, so set the SAME value on both the
# Python app and the Go proxy (a Fly app-wide secret) before enabling the Go
# native query flag. Never exposed at the public edge (the proxy 404s the
# /internal/ subtree). Empty value = unset = endpoint disabled.
# INTERNAL_RAG_TOKEN=
# Comma-separated CORS allowlist for the Next.js UI. With allow_credentials=True
# on the API, this is what stops other origins from riding the session cookie,
# so keep it tight. Set to your deployed frontend origin(s) in production.
CORS_ALLOW_ORIGINS_CSV=http://localhost:3000,http://127.0.0.1:3000

# ---------- Deficiency analysis (DefPredict) ----------
# Upload->analyze jobs run as background tasks inside the API process
# (DECISIONS.md 2026-07-30). Wall-clock deadline per analysis; past it the run
# is marked failed and the worker thread is abandoned (CAS transitions keep the
# late thread harmless).
DEFICIENCY_ANALYZE_TIMEOUT_S=600
# Concurrent analyses (each fans out LLM specialist calls); extra jobs queue.
DEFICIENCY_ANALYZE_CONCURRENCY=2
# A run still pending/running after this many minutes (process restart) reads
# as failed; the row itself is never rewritten.
DEFICIENCY_RUN_STALE_MINUTES=20
# Historical precedents retrieved per detection domain from deficiency_kb.
DEFICIENCY_PRECEDENT_TOP_K=3
# OPTIONAL remote OCR for scanned pages: the FULL Databricks Model Serving
# .../invocations URL + its bearer token. Leave both unset to disable OCR --
# scanned pages then fall back to the embedded text layer.
# DEFICIENCY_OCR_INVOCATIONS_URL=
# DEFICIENCY_OCR_TOKEN=
