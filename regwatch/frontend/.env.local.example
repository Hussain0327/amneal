# Usually you don't need to set anything here.
#
# By default the UI proxies API calls through itself at /api (see
# next.config.mjs) so the browser only talks to the Next origin. This is what
# makes a SINGLE cloudflared tunnel over :3000 expose the whole app.

# Where the Next server proxies /api/* to (server-side). Default below.
# API_PROXY_TARGET=http://localhost:8000

# Advanced: bypass the proxy and have the BROWSER call the API directly. This
# requires the API's CORS allowlist (cors_allow_origins) to include this UI's
# origin. Leave unset to use the /api proxy.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
